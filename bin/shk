#!/usr/bin/env python3
"""Global shk (contract C4): run the sherlock_kit source of the checkout this file is in.

Standard library only. It follows symlinks to <repo>/bin/shk, puts <repo>/src first on
sys.path and writes no bytecode, so a dotfiles submodule stays clean. Keep it parseable by old
Pythons, which it refuses with a message.
"""

import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write(
        "shk: Python 3.11 or newer is required; this is %d.%d (%s)\n"
        % (sys.version_info[0], sys.version_info[1], sys.executable)
    )
    sys.exit(1)

sys.dont_write_bytecode = True
sys.path.insert(
    0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src")
)

import sherlock_kit.cli  # noqa: E402

sys.exit(sherlock_kit.cli.main())
